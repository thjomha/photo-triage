[Unit]
Description=Photo Triage LAN file API
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/photos

[Service]
Type=simple
User=photo-triage
WorkingDirectory=/opt/photo-triage/lan-api
EnvironmentFile=/etc/photo-triage.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
